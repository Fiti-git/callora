    "test:billing": "npm test --workspace @callora/billing-service",
    "test:platform": "npm test --workspace @callora/platform-service",
    "test:gateway": "npm test --workspace @callora/api-gateway"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
