generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

enum OrgStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  PAUSED_NO_CREDIT
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum DunningStatus {
  ACTIVE
  RETRY_SCHEDULED
  WARNED
  SUSPENDED
  RESOLVED
  CANCELED
}

// Model B PAYG (Phase 5 Agent M1). Mirror of backend/prisma/schema.prisma.
enum BillingMode {
  PAYG
  SUBSCRIPTION
  BYOK
}

enum ProvisioningStatus {
  PENDING
  PROVISIONING
  READY
  FAILED
  SUSPENDED
  DEPROVISIONED
}

// Platform-owned Vapi number lifecycle (Phase 6 — tenant key removal).
enum VapiNumberStatus {
  ACTIVE
  RELEASED
  POOL
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  password           String
  name               String?
  role               Role         @default(MEMBER)
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  emailVerified      Boolean      @default(false)
  verifyToken        String?      @unique
  verifyTokenExp     DateTime?
  // Bumped on password reset to invalidate every JWT signed with the old value.
  tokenVersion       Int          @default(0)
  // 2FA (TOTP) — Phase 1 Agent 3. See backend/prisma/schema.prisma for notes.
  twoFASecret        String?
  twoFAEnabled       Boolean      @default(false)
  twoFARecoveryCodes String[]
  // SSO (Phase 3 Agent 12).
  lastLoginAt        DateTime?
  ssoProvider        String?
  ssoSubject         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  assignedLeads       Lead[]               @relation("LeadAssignee")
  assignedTasks       Task[]               @relation("TaskAssignee")
  assignedDeals       Deal[]               @relation("DealAssignee")
  ownedDeals          Deal[]               @relation("DealOwner")
  ownedContacts       Contact[]            @relation("ContactOwner")
  dealHistories       DealHistory[]
  notes               Note[]
  passwordResetTokens PasswordResetToken[]
  emailCampaigns      EmailCampaign[]
  publicApiKeys       PublicApiKey[]

  @@index([ssoProvider, ssoSubject])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id                  String               @id @default(cuid())
  name                String
  status              OrgStatus            @default(TRIAL)
  aiCallerName        String               @default("Alex")
  aiCallerCompany     String               @default("")
  aiCallerPhone       String               @default("")
  aiSystemPrompt      String?
  onboardingStep      String               @default("verify_email") // verify_email | choose_plan | setup_caller | complete
  vapiPhoneNumberId   String? // Vapi phone-number object ID (provisioned on Stripe checkout)
  vapiPhoneNumber     String? // E.164 number shown to the tenant e.g. +14155551234
  gdprDeletedAt       DateTime?
  // Phase 3 Agent 12 — Zapier instant-trigger token.
  zapierTriggerToken  String?              @unique
  // Model B PAYG (Agent M1).
  billingMode         BillingMode          @default(PAYG)
  vapiNumber          OrgVapiNumber?
  spendCap            SpendCap?
  provisioning        TenantProvisioning?
  creditLedger        CreditLedger?
  creditTransactions  CreditTransaction[]
  users               User[]
  campaigns           Campaign[]
  leads               Lead[]
  blacklist           Blacklist[]
  contacts            Contact[]
  notes               Note[]
  tasks               Task[]
  deals               Deal[]
  dealHistories       DealHistory[]
  subscription        Subscription?
  usage               UsageRecord[]
  dunningStates       DunningState[]
  dncEntries          DNCEntry[]
  emailSuppressions   EmailSuppression[]
  emailCampaigns      EmailCampaign[]
  emailRecipientLists EmailRecipientList[]
  emailSends          EmailSend[]
  emailTemplates      EmailTemplate[]
  emailAutomations    EmailAutomation[]
  emailAutomationRuns EmailAutomationRun[]
  tenantWebhooks      TenantWebhook[]
  webhookDeliveries   WebhookDelivery[]
  publicApiKeys       PublicApiKey[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([gdprDeletedAt])
}

model PlatformUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  isSuperAdmin Boolean  @default(false)
  twoFASecret  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Plan {
  id                      String         @id @default(cuid())
  tier                    PlanTier       @unique
  name                    String
  stripePriceId           String         @unique
  monthlyCallQuota        Int
  monthlyLeadQuota        Int
  seatLimit               Int
  priceCents              Int
  maxCallsPerMonth        Int?
  maxPlacesPerMonth       Int?
  maxGeminiTokensPerMonth Int?
  maxEmailsPerMonth       Int?
  maxApiCallsPerMonth     Int?
  subscriptions           Subscription[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id])
  planId               String
  plan                 Plan         @relation(fields: [planId], references: [id])
  status               SubStatus    @default(TRIALING)
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model UsageRecord {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  periodStart       DateTime
  periodEnd         DateTime
  callsMade         Int          @default(0)
  leadsScraped      Int          @default(0)
  aiTokens          Int          @default(0)
  placesScraped     Int          @default(0)
  emailsSent        Int          @default(0)
  apiCallsThisMonth Int          @default(0)
  vapiSpendCents    Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, periodStart])
}

model AuditLog {
  id                   String   @id @default(cuid())
  actorType            String
  actorId              String
  organizationId       String?
  targetOrganizationId String?
  action               String
  entity               String?
  entityId             String?
  target               String?
  metadata             Json?
  createdAt            DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([targetOrganizationId, createdAt])
  @@index([actorType, actorId])
  @@index([entity, entityId])
}

// See backend/prisma/schema.prisma for full doc. Mirrored here so the shared
// Prisma client used by microservices has the same model.
model EmailLog {
  id                String   @id @default(cuid())
  organizationId    String?
  recipient         String
  subject           String
  template          String?
  status            String
  providerMessageId String?
  error             String?
  createdAt         DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([recipient])
  @@index([status])
}

model Campaign {
  id             String       @id @default(cuid())
  name           String
  type           String       @default("AI")
  prompt         String?
  status         String       @default("DRAFT")
  jobId          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  leads          Lead[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  maxRetryAttempts  Int @default(3)
  retryDelayHours   Int @default(24)
  followUpDelayDays Int @default(3)

  deletedAt DateTime?

  @@index([deletedAt])
}

model Contact {
  id                  String                     @id @default(cuid())
  businessName        String
  phone               String
  address             String?
  email               String?
  tags                String[]                   @default([])
  ownerId             String?
  owner               User?                      @relation("ContactOwner", fields: [ownerId], references: [id])
  organizationId      String
  organization        Organization               @relation(fields: [organizationId], references: [id])
  leads               Lead[]
  notes               Note[]
  tasks               Task[]
  deals               Deal[]
  emailListMembers    EmailRecipientListMember[]
  emailSends          EmailSend[]
  emailAutomationRuns EmailAutomationRun[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  deletedAt DateTime?

  @@unique([phone, organizationId])
  @@index([deletedAt])
  @@index([ownerId])
}

model Lead {
  id             String       @id @default(cuid())
  businessName   String
  address        String?
  phone          String?
  notes          String?
  status         String       @default("NEW")
  interestScore  Int          @default(0)
  campaignId     String
  campaign       Campaign     @relation(fields: [campaignId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  calls          CallLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  callAttempts Int       @default(0)
  nextCallAt   DateTime?
  followUpAt   DateTime?

  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("LeadAssignee", fields: [assignedToId], references: [id])
  leadNotes    Note[]
  tasks        Task[]

  // TCPA compliance (Phase 2 Agent 9).
  consentGiven     Boolean   @default(false)
  consentTimestamp DateTime?
  consentSource    String?
  consentIpAddress String?
  doNotCall        Boolean   @default(false)
  doNotCallReason  String?
  doNotCallAt      DateTime?
  state            String?
  timezone         String?

  deletedAt DateTime?

  @@index([deletedAt])
  @@index([doNotCall])
  @@index([state])
}

model CallLog {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id])
  duration   Int
  status     String
  transcript String?
  summary    String?
  createdAt  DateTime @default(now())

  vapiCallId    String? @unique
  cost          Float?
  costBreakdown Json?

  deletedAt DateTime?

  @@index([deletedAt])
}

model Note {
  id             String       @id @default(cuid())
  content        String
  type           String       @default("NOTE")
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  deletedAt DateTime?

  @@index([leadId])
  @@index([contactId])
  @@index([deletedAt])
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  dueDate        DateTime?
  completed      Boolean      @default(false)
  completedAt    DateTime?
  assignedToId   String?
  assignedTo     User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  deletedAt DateTime?

  @@index([organizationId, completed, dueDate])
  @@index([deletedAt])
}

model Deal {
  id             String        @id @default(cuid())
  title          String
  value          Float?
  probability    Int?
  stage          String        @default("PROSPECT")
  closeDate      DateTime?
  notes          String?
  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id])
  assignedToId   String?
  assignedTo     User?         @relation("DealAssignee", fields: [assignedToId], references: [id])
  ownerId        String?
  owner          User?         @relation("DealOwner", fields: [ownerId], references: [id])
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  histories      DealHistory[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  deletedAt DateTime?

  @@index([organizationId, stage])
  @@index([deletedAt])
  @@index([ownerId])
}

model DealHistory {
  id             String   @id @default(cuid())
  dealId         String
  organizationId String
  fromStage      String?
  toStage        String
  changedById    String?
  reason         String?
  createdAt      DateTime @default(now())

  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation(fields: [changedById], references: [id])

  @@index([dealId, createdAt])
  @@index([organizationId, createdAt])
}

// Dunning state machine — tracks failed-invoice retry cycles. See
// backend/src/workers/dunningWorker.ts for the cadence + transitions.
model DunningState {
  id              String        @id @default(cuid())
  organizationId  String
  invoiceId       String        @unique
  subscriptionId  String?
  attempt         Int           @default(0)
  status          DunningStatus @default(ACTIVE)
  firstFailedAt   DateTime      @default(now())
  nextActionAt    DateTime
  lastEmailSentAt DateTime?
  resolvedAt      DateTime?
  amountDueCents  Int?
  currency        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([nextActionAt, status])
}

// Stripe webhook idempotency record. Same shape as backend/prisma/schema.prisma.
model StripeWebhookEvent {
  id          String    @id
  type        String
  livemode    Boolean   @default(false)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt])
  @@index([type])
}

// TCPA call-window config (Phase 2 Agent 9). See backend/prisma/schema.prisma.
model CallWindowConfig {
  id          String   @id @default(cuid())
  state       String   @unique
  allowedFrom String
  allowedTo   String
  timezone    String
  source      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DNCEntry {
  id             String   @id @default(cuid())
  phoneHash      String
  organizationId String?
  source         String
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([phoneHash, organizationId])
  @@index([organizationId, createdAt])
}

model EmailSuppression {
  id             String   @id @default(cuid())
  email          String
  organizationId String?
  reason         String
  source         String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([email, organizationId])
  @@index([organizationId, createdAt])
}

model ResendWebhookEvent {
  id          String    @id
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt])
  @@index([type])
}

// ====================================================================
// Email Marketing (Phase 3 Agent 10) — mirrored from backend/prisma/schema.prisma
// ====================================================================

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  FAILED
}

enum EmailSendStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
  FAILED
}

enum EmailRecipientSource {
  MANUAL
  CSV_IMPORT
  CAMPAIGN
  API
}

enum EmailAutomationTrigger {
  LEAD_QUALIFIED
  DEAL_WON
  CONTACT_CREATED
  CAMPAIGN_COMPLETE
}

model EmailCampaign {
  id                String              @id @default(cuid())
  organizationId    String
  name              String
  subject           String
  previewText       String?
  htmlBody          String
  textBody          String?
  status            EmailCampaignStatus @default(DRAFT)
  scheduledAt       DateTime?
  sentAt            DateTime?
  fromName          String
  fromEmail         String
  replyTo           String?
  totalRecipients   Int                 @default(0)
  totalSent         Int                 @default(0)
  totalDelivered    Int                 @default(0)
  totalOpened       Int                 @default(0)
  totalClicked      Int                 @default(0)
  totalBounced      Int                 @default(0)
  totalUnsubscribed Int                 @default(0)
  totalComplained   Int                 @default(0)
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipientLists EmailCampaignList[]
  sends          EmailSend[]
  createdBy      User?               @relation(fields: [createdById], references: [id])

  @@index([organizationId, status])
  @@index([deletedAt])
}

model EmailRecipientList {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  memberCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      EmailRecipientListMember[]
  campaigns    EmailCampaignList[]

  @@index([organizationId])
  @@index([deletedAt])
}

model EmailCampaignList {
  campaignId String
  listId     String
  campaign   EmailCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  list       EmailRecipientList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([campaignId, listId])
}

model EmailRecipientListMember {
  id             String               @id @default(cuid())
  listId         String
  contactId      String?
  email          String
  source         EmailRecipientSource
  subscribedAt   DateTime             @default(now())
  unsubscribedAt DateTime?

  list    EmailRecipientList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([listId, email])
  @@index([listId, unsubscribedAt])
  @@index([email])
}

model EmailSend {
  id                String          @id @default(cuid())
  campaignId        String
  contactId         String?
  organizationId    String
  email             String
  status            EmailSendStatus @default(QUEUED)
  providerMessageId String?         @unique
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  complainedAt      DateTime?
  unsubscribedAt    DateTime?
  failedAt          DateTime?
  errorMessage      String?
  createdAt         DateTime        @default(now())

  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([organizationId, status, createdAt])
  @@index([providerMessageId])
}

model EmailTemplate {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  subject        String
  htmlBody       String
  textBody       String?
  category       String?
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, category])
  @@index([deletedAt])
}

model EmailAutomation {
  id             String                 @id @default(cuid())
  organizationId String
  name           String
  trigger        EmailAutomationTrigger
  active         Boolean                @default(false)
  sequence       Json
  stats          Json                   @default("{}")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         EmailAutomationRun[]

  @@index([organizationId, active])
  @@index([deletedAt])
}

model EmailAutomationRun {
  id             String   @id @default(cuid())
  automationId   String
  organizationId String
  contactId      String?
  triggeredAt    DateTime @default(now())
  currentStep    Int      @default(0)
  status         String
  context        Json

  automation   EmailAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([automationId, status])
  @@index([organizationId, triggeredAt])
}

model Blacklist {
  id             String       @id @default(cuid())
  phoneNumber    String
  reason         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  deletedAt DateTime?

  @@index([deletedAt])
}

// ====================================================================
// Phase 3 Agent 12 — Per-tenant webhooks + public API.
// ====================================================================

enum WebhookEvent {
  LEAD_QUALIFIED
  CALL_COMPLETED
  DEAL_WON
  CAMPAIGN_COMPLETED
  EMAIL_OPENED
  EMAIL_CLICKED
}

model TenantWebhook {
  id             String         @id @default(cuid())
  organizationId String
  url            String
  events         WebhookEvent[]
  secret         String
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId, active])
  @@index([deletedAt])
}

model WebhookDelivery {
  id             String       @id @default(cuid())
  webhookId      String
  organizationId String
  event          WebhookEvent
  payload        Json
  status         String
  responseCode   Int?
  responseBody   String?
  attempts       Int          @default(0)
  lastAttemptAt  DateTime?
  createdAt      DateTime     @default(now())

  webhook      TenantWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
  @@index([organizationId, createdAt])
  @@index([status, lastAttemptAt])
}

model PublicApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyHash        String    @unique
  prefix         String
  scopes         String[]  @default(["read"])
  lastUsedAt     DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id])

  @@index([organizationId, revokedAt])
  @@index([prefix])
}

// ====================================================================
// Phase 5 Agent M1 — Model B PAYG: Provisioning + Credit ledger.
// (Mirror of backend/prisma/schema.prisma — see that file for canonical docs.)
// Soft-delete: NONE of these models are soft-delete candidates. CreditTransaction
// is immutable accounting history; TenantProvisioning + CreditLedger are 1:1
// with Organization and follow its lifecycle.
// ====================================================================

model TenantProvisioning {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  status                 ProvisioningStatus @default(PENDING)
  vapiAssistantId        String?
  vapiPhoneNumberId      String?
  vapiPhoneE164          String?
  stripeCustomerId       String?
  defaultPaymentMethodId String?
  failureReason          String?
  steps                  Json               @default("{}")
  provisionedAt          DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
}

model CreditLedger {
  id                         String    @id @default(cuid())
  organizationId             String    @unique
  balanceCents               Int       @default(0)
  lifetimeAddedCents         Int       @default(0)
  lifetimeSpentCents         Int       @default(0)
  autoRechargeEnabled        Boolean   @default(true)
  autoRechargeThresholdCents Int       @default(1000)
  autoRechargeAmountCents    Int       @default(2500)
  lastAutoRechargeAt         DateTime?
  lowBalanceAlertSentAt      DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
}

model CreditTransaction {
  id                String   @id @default(cuid())
  ledgerId          String
  organizationId    String
  kind              String
  amountCents       Int
  balanceAfterCents Int
  ref               String?
  metadata          Json?
  createdAt         DateTime @default(now())

  ledger       CreditLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([ref])
}

// ====================================================================
// Phase 6 — Platform-owned API key infrastructure.
// All third-party API keys (Google Places, Gemini, Vapi) are owned by
// Callora at the platform level. Tenants no longer store their own keys.
// Trial users share a pool Vapi number; paid users get a dedicated
// provisioned number tracked here.
// ====================================================================

model OrgVapiNumber {
  id                String           @id @default(cuid())
  organizationId    String           @unique
  vapiPhoneNumberId String
  e164              String
  provider          String           @default("vapi")
  status            VapiNumberStatus @default(POOL)
  monthlyCostCents  Int
  provisionedAt     DateTime
  releasedAt        DateTime?
  spamScore         Float?
  lastRotatedAt     DateTime?
  areaCode          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([areaCode])
}

model SpendCap {
  id                String   @id @default(cuid())
  organizationId    String   @unique
  dailyCapCents     Int
  monthlyCapCents   Int
  currentDayCents   Int      @default(0)
  currentMonthCents Int      @default(0)
  lastDayResetAt    DateTime
  lastMonthResetAt  DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Platform-wide DNC scrub cache (FTC list, complaint feedback, manual adds).
// Distinct from per-tenant DNCEntry above which stores hashed phone numbers
// scoped to an organization.
model DncEntry {
  id        String    @id @default(cuid())
  phoneE164 String    @unique
  source    String
  addedAt   DateTime  @default(now())
  expiresAt DateTime?

  @@index([source])
  @@index([expiresAt])
}

// Audit trail for platform-level secret fetches from the key vault.
model KeyAccessLog {
  id        String   @id @default(cuid())
  service   String
  keyName   String
  fetchedAt DateTime @default(now())
  success   Boolean

  @@index([service, fetchedAt])
}

// Platform-owned secrets editable from the admin UI. Values are AES-256-GCM
// encrypted at rest with SECRETS_ENCRYPTION_KEY (32-byte base64).
// Read by the `db` SecretBackend; falls back to env for bootstrap secrets
// (DATABASE_URL, NEXTAUTH_SECRET, PLATFORM_JWT_SECRET, SECRETS_ENCRYPTION_KEY).
model PlatformSecret {
  key            String   @id
  valueEncrypted String // base64(iv || authTag || ciphertext)
  description    String?
  updatedBy      String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}
