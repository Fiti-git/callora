{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "components/*": ["./src/horizon-ui/components/*"],
      "utils/*": ["./src/horizon-ui/utils/*"],
      "types/*": ["./src/horizon-ui/types/*"],
      "variables/*": ["./src/horizon-ui/variables/*"],
      "styles/*": ["./src/horizon-ui/styles/*"],
      "routes": ["./src/horizon-ui/routes.tsx"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "legacy_cli",
    "src/horizon-ui/components/admin",
    "src/horizon-ui/components/auth",
    "src/horizon-ui/components/calendar",
    "src/horizon-ui/components/rtl",
    "src/horizon-ui/components/rtlProvider",
    "src/horizon-ui/components/popover",
    "src/horizon-ui/components/tooltip",
    "src/horizon-ui/components/image",
    "src/horizon-ui/components/scrollbar",
    "src/horizon-ui/components/sidebar/RTL.tsx",
    "src/horizon-ui/components/sidebar/componentsrtl",
    "src/horizon-ui/components/navbar/RTL.tsx"
  ]
}
