generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  password       String
  name           String?
  role           String       @default("MEMBER") // ADMIN, MEMBER, VIEWER
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignedLeads  Lead[]       @relation("LeadAssignee")
  assignedTasks  Task[]       @relation("TaskAssignee")
  assignedDeals  Deal[]       @relation("DealAssignee")
  notes          Note[]
}

model Organization {
  id        String      @id @default(cuid())
  name      String
  apiKeys   ApiKey?
  users     User[]
  campaigns Campaign[]
  leads     Lead[]
  blacklist Blacklist[]
  contacts  Contact[]
  notes     Note[]
  tasks     Task[]
  deals     Deal[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model ApiKey {
  id             String       @id @default(cuid())
  googleMapsKey  String?
  geminiKey      String?
  vapiKey        String?
  vapiPhoneId    String?
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Campaign {
  id             String       @id @default(cuid())
  name           String
  type           String       @default("AI") // AI, CSV
  prompt         String?
  status         String       @default("DRAFT") // DRAFT, RUNNING, COMPLETED
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  leads          Lead[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Follow-up automation config
  maxRetryAttempts  Int @default(3)
  retryDelayHours   Int @default(24)
  followUpDelayDays Int @default(3)
}

model Contact {
  id             String       @id @default(cuid())
  businessName   String
  phone          String
  address        String?
  email          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  leads          Lead[]
  notes          Note[]
  tasks          Task[]
  deals          Deal[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([phone, organizationId])
}

model Lead {
  id             String       @id @default(cuid())
  businessName   String
  address        String?
  phone          String?
  notes          String?
  status         String       @default("NEW") // NEW, CALLED, QUALIFIED, DISQUALIFIED, PENDING_RETRY, PENDING_FOLLOWUP
  interestScore  Int          @default(0)
  campaignId     String
  campaign       Campaign     @relation(fields: [campaignId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  calls          CallLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Follow-up automation state
  callAttempts Int       @default(0)
  nextCallAt   DateTime?
  followUpAt   DateTime?

  // CRM relations
  contactId    String?
  contact      Contact?     @relation(fields: [contactId], references: [id])
  assignedToId String?
  assignedTo   User?        @relation("LeadAssignee", fields: [assignedToId], references: [id])
  leadNotes    Note[]
  tasks        Task[]
}

model CallLog {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  duration  Int
  status    String
  transcript String?
  summary   String?
  createdAt DateTime @default(now())

  vapiCallId    String?
  cost          Float?
  costBreakdown Json?
}

model Note {
  id             String       @id @default(cuid())
  content        String
  type           String       @default("NOTE") // NOTE, CALL, EMAIL, STATUS_CHANGE
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([leadId])
  @@index([contactId])
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  dueDate        DateTime?
  completed      Boolean      @default(false)
  completedAt    DateTime?
  assignedToId   String?
  assignedTo     User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, completed, dueDate])
}

model Deal {
  id             String       @id @default(cuid())
  title          String
  value          Float?
  probability    Int?         // 0-100
  stage          String       @default("PROSPECT") // PROSPECT, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  closeDate      DateTime?
  notes          String?
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation("DealAssignee", fields: [assignedToId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, stage])
}

model Blacklist {
  id             String       @id @default(cuid())
  phoneNumber    String
  reason         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
}
