generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

enum OrgStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  // Phase 5 Agent M5 — soft pause when the PAYG ledger hits 0 mid-campaign.
  // Differs from SUSPENDED (admin-initiated) and PAST_DUE (subscription dunning):
  // PAUSED_NO_CREDIT is recoverable automatically — the next successful TOPUP
  // / TOPUP_AUTO flips the org back to ACTIVE via the Stripe webhook handler.
  PAUSED_NO_CREDIT
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum DunningStatus {
  ACTIVE
  RETRY_SCHEDULED
  WARNED
  SUSPENDED
  RESOLVED
  CANCELED
}

// Model B PAYG (Phase 5 Agent M1). Determines whether a tenant's usage is
// metered against the Callora-managed PAYG ledger, an old-world subscription
// (dormant — not used by any new orgs), or whether the tenant has opted in
// to BYOK (Bring-Your-Own-Keys). BYOK is admin-only; tenant-side update
// endpoints reject any payload that tries to set this. See the platform
// route `PATCH /api/platform/organizations/:id/billing-mode`.
enum BillingMode {
  PAYG
  SUBSCRIPTION   // dormant; super-admin only
  BYOK           // admin-only; for Callora's internal QA orgs
}

enum ProvisioningStatus {
  PENDING
  PROVISIONING
  READY
  FAILED
  SUSPENDED
  DEPROVISIONED
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  password       String
  name           String?
  role           Role         @default(MEMBER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  emailVerified  Boolean      @default(false)
  verifyToken    String?      @unique
  verifyTokenExp DateTime?
  // Bumped on password reset to invalidate every JWT signed with the old value.
  tokenVersion   Int          @default(0)
  // 2FA (TOTP) — Phase 1 Agent 3.
  // `twoFASecret` is the base32 TOTP secret; stored as plaintext today (flagged
  // in the agent report — encrypt at rest before tier-1 prod). `twoFARecoveryCodes`
  // holds 10 single-use SHA-256-hashed codes. Codes are removed as they're used.
  twoFASecret         String?
  twoFAEnabled        Boolean  @default(false)
  twoFARecoveryCodes  String[]
  // SSO (Phase 3 Agent 12). Set on first SSO login; updated on every SSO login.
  // Plain Credentials login also bumps lastLoginAt for activity reporting.
  lastLoginAt    DateTime?
  // SSO provider sub claim — Google `sub` or Microsoft `oid`. Allows us to
  // detect the same external identity even if the email changes case.
  ssoProvider    String?      // "GOOGLE" | "MICROSOFT" | null
  ssoSubject     String?      // provider-specific sub/oid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignedLeads  Lead[]       @relation("LeadAssignee")
  assignedTasks  Task[]       @relation("TaskAssignee")
  assignedDeals  Deal[]       @relation("DealAssignee")
  ownedDeals     Deal[]       @relation("DealOwner")
  ownedContacts  Contact[]    @relation("ContactOwner")
  dealHistories  DealHistory[]
  notes          Note[]
  passwordResetTokens PasswordResetToken[]
  emailCampaigns EmailCampaign[]
  publicApiKeys  PublicApiKey[]

  @@index([ssoProvider, ssoSubject])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  status       OrgStatus     @default(TRIAL)
  aiCallerName    String  @default("Alex")
  aiCallerCompany String  @default("")
  aiCallerPhone   String  @default("")
  aiSystemPrompt  String?
  onboardingStep     String  @default("verify_email") // verify_email | choose_plan | setup_caller | complete
  vapiPhoneNumberId  String? // Vapi phone-number object ID (provisioned on Stripe checkout)
  vapiPhoneNumber    String? // E.164 number shown to the tenant e.g. +14155551234
  // GDPR (Phase 1 Agent 6): set when an admin runs DELETE /api/gdpr/delete.
  // PII on this org's User/Contact/Lead/CallLog is anonymised and child entities
  // are soft-deleted; the org row itself stays for audit-trail integrity.
  gdprDeletedAt      DateTime?
  // Phase 3 Agent 12 — Zapier instant-trigger token. Long-lived, opaque
  // random token used by Zapier (or any 3rd-party integration) to subscribe
  // to webhooks without a tenant JWT. Rotated by regenerating the token.
  zapierTriggerToken String?   @unique
  // Model B PAYG (Agent M1). Defaults to PAYG for every new org; super-admin
  // flips to BYOK for internal QA orgs only via /api/platform/organizations/:id/billing-mode.
  // SUBSCRIPTION is dormant — preserved as an enum value for historical
  // continuity but no new orgs are placed in this mode.
  billingMode  BillingMode   @default(PAYG)
  apiKeys      ApiKey?
  provisioning       TenantProvisioning?
  creditLedger       CreditLedger?
  creditTransactions CreditTransaction[]
  users        User[]
  campaigns    Campaign[]
  leads        Lead[]
  blacklist    Blacklist[]
  contacts     Contact[]
  notes        Note[]
  tasks        Task[]
  deals        Deal[]
  dealHistories DealHistory[]
  subscription Subscription?
  usage        UsageRecord[]
  dunningStates DunningState[]
  dncEntries    DNCEntry[]
  emailSuppressions EmailSuppression[]
  emailCampaigns      EmailCampaign[]
  emailRecipientLists EmailRecipientList[]
  emailSends          EmailSend[]
  emailTemplates      EmailTemplate[]
  emailAutomations    EmailAutomation[]
  emailAutomationRuns EmailAutomationRun[]
  tenantWebhooks      TenantWebhook[]
  webhookDeliveries   WebhookDelivery[]
  publicApiKeys       PublicApiKey[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([gdprDeletedAt])
}

model PlatformUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  isSuperAdmin Boolean  @default(false)
  twoFASecret  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Plan {
  id                String         @id @default(cuid())
  tier              PlanTier       @unique
  name              String
  stripePriceId     String         @unique
  monthlyCallQuota  Int
  monthlyLeadQuota  Int
  seatLimit         Int
  priceCents        Int
  // Per-resource monthly limits (nullable == unlimited). Used by the
  // `meterAndCharge(orgId, kind, units)` helper in @callora/shared.
  // maxCallsPerMonth, when set, overrides monthlyCallQuota for VAPI_CALL.
  maxCallsPerMonth        Int?
  maxPlacesPerMonth       Int?
  maxGeminiTokensPerMonth Int?
  maxEmailsPerMonth       Int?
  // Phase 3 Agent 12 — public API quota. Counts every /api/v1/* request.
  maxApiCallsPerMonth     Int?
  subscriptions     Subscription[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id])
  planId               String
  plan                 Plan         @relation(fields: [planId], references: [id])
  status               SubStatus    @default(TRIALING)
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model UsageRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  callsMade      Int          @default(0)
  leadsScraped   Int          @default(0)
  aiTokens       Int          @default(0)
  placesScraped  Int          @default(0)
  emailsSent     Int          @default(0)
  // Phase 3 Agent 12 — public API call counter (one per /api/v1/* request).
  apiCallsThisMonth Int       @default(0)
  // Phase 5 Agent M5 — running monthly Vapi spend in cents (post-markup).
  // Counter so admin / MRR / analytics can report PAYG spend per period
  // without having to scan the immutable CreditTransaction history.
  vapiSpendCents Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, periodStart])
}

model AuditLog {
  id                    String   @id @default(cuid())
  // Canonical actorType values (see backend/src/lib/audit.ts):
  //   "PLATFORM_USER" | "TENANT_USER" | "SYSTEM"
  // Older rows may carry "PLATFORM" / "TENANT" / "USER" — they are migrated
  // forward by the soft-delete migration. New writes MUST use the canonical set.
  actorType             String
  actorId               String
  organizationId        String?
  // Target org for tenant-side actions. Distinct from `organizationId` (which
  // can also refer to the platform-side context). Always populated by
  // writeAuditLog for tenant requests so the tenant audit-log endpoint can
  // filter cleanly. Nullable for platform/system actions that aren't org-bound.
  targetOrganizationId  String?
  action                String
  // Entity name + id for typed targets (e.g. "Lead", "<leadId>"). The legacy
  // `target` field is preserved for backward compatibility (e.g. DLQ which
  // writes "queue:jobId").
  entity                String?
  entityId              String?
  target                String?
  metadata              Json?
  createdAt             DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([targetOrganizationId, createdAt])
  @@index([actorType, actorId])
  @@index([entity, entityId])
}

// Outbound email log. Every sendEmail call writes a row here regardless of
// success — status=SENT|FAILED. Resend webhook integration in Phase 2 will
// later flip status (e.g. DELIVERED/BOUNCED). organizationId is nullable for
// pre-org-link flows (password reset, verify-email).
//
// NOTE for Agent 6 (soft-delete + GDPR): this model is tenant-bound when
// organizationId is set; the soft-delete middleware should add `deletedAt`
// here too and exclude rows from the org-scoped admin listings.
model EmailLog {
  id                String   @id @default(cuid())
  organizationId    String?
  recipient         String
  subject           String
  template          String?
  status            String   // SENT | FAILED
  providerMessageId String?
  error             String?
  createdAt         DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([recipient])
  @@index([status])
}

model ApiKey {
  id             String       @id @default(cuid())
  googleMapsKey  String?
  geminiKey      String?
  vapiKey        String?
  vapiPhoneId    String?
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Campaign {
  id             String       @id @default(cuid())
  name           String
  type           String       @default("AI") // AI, CSV
  prompt         String?
  status         String       @default("DRAFT") // DRAFT, RUNNING, COMPLETED, PAUSED_QUOTA, CANCELLED, FAILED
  jobId          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  leads          Lead[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Follow-up automation config
  maxRetryAttempts  Int @default(3)
  retryDelayHours   Int @default(24)
  followUpDelayDays Int @default(3)

  // Soft-delete (Phase 1 Agent 6). Filtered out automatically by the prisma
  // extension in `backend/src/lib/prismaSoftDelete.ts`.
  deletedAt      DateTime?

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([deletedAt])
}

model Contact {
  id             String       @id @default(cuid())
  businessName   String
  phone          String
  address        String?
  email          String?
  // Phase 2 Agent 7 — bulk-tag + bulk-assign-owner.
  tags           String[]     @default([])
  ownerId        String?
  owner          User?        @relation("ContactOwner", fields: [ownerId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  leads          Lead[]
  notes          Note[]
  tasks          Task[]
  deals          Deal[]
  emailListMembers    EmailRecipientListMember[]
  emailSends          EmailSend[]
  emailAutomationRuns EmailAutomationRun[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Soft-delete (Phase 1 Agent 6).
  deletedAt      DateTime?

  @@unique([phone, organizationId])
  @@index([organizationId, createdAt])
  @@index([deletedAt])
  @@index([ownerId])
}

model Lead {
  id             String       @id @default(cuid())
  businessName   String
  address        String?
  phone          String?
  notes          String?
  status         String       @default("NEW") // NEW, CALLED, QUALIFIED, DISQUALIFIED, PENDING_RETRY, PENDING_FOLLOWUP
  interestScore  Int          @default(0)
  campaignId     String
  campaign       Campaign     @relation(fields: [campaignId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  calls          CallLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Follow-up automation state
  callAttempts Int       @default(0)
  nextCallAt   DateTime?
  followUpAt   DateTime?

  // CRM relations
  contactId    String?
  contact      Contact?     @relation(fields: [contactId], references: [id])
  assignedToId String?
  assignedTo   User?        @relation("LeadAssignee", fields: [assignedToId], references: [id])
  leadNotes    Note[]
  tasks        Task[]

  // TCPA compliance (Phase 2 Agent 9). consentGiven must be true and
  // doNotCall must be false before any outbound call. state/timezone drive
  // call-window enforcement; timezone falls back via state lookup if null.
  consentGiven      Boolean   @default(false)
  consentTimestamp  DateTime?
  consentSource     String?   // WEB_FORM | API | CSV_IMPORT | MANUAL | OPT_IN_CALL
  consentIpAddress  String?
  doNotCall         Boolean   @default(false)
  doNotCallReason   String?
  doNotCallAt       DateTime?
  state             String?   // 2-letter US state code
  timezone          String?   // IANA TZ (e.g. "America/New_York")

  // Soft-delete (Phase 1 Agent 6).
  deletedAt    DateTime?

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([campaignId, status])
  @@index([campaignId, status, nextCallAt])
  @@index([campaignId, status, followUpAt])
  @@index([organizationId, contactId])
  @@index([deletedAt])
  @@index([doNotCall])
  @@index([state])
}

model CallLog {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  duration  Int
  status    String
  transcript String?
  summary   String?
  createdAt DateTime @default(now())

  vapiCallId    String?  @unique
  cost          Float?
  costBreakdown Json?

  // Soft-delete. CallLog deletion is NOT user-initiated — this column exists
  // so cascade-style soft-deletes (e.g. when a Lead is anonymised) can mark
  // child rows without dropping audit trail.
  deletedAt DateTime?

  @@index([leadId, createdAt])
  @@index([createdAt])
  @@index([deletedAt])
}

model Note {
  id             String       @id @default(cuid())
  content        String
  type           String       @default("NOTE") // NOTE, CALL, EMAIL, STATUS_CHANGE
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Soft-delete (Phase 1 Agent 6).
  deletedAt      DateTime?

  @@index([leadId])
  @@index([contactId])
  @@index([organizationId, createdAt])
  @@index([deletedAt])
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  dueDate        DateTime?
  completed      Boolean      @default(false)
  completedAt    DateTime?
  assignedToId   String?
  assignedTo     User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Soft-delete (Phase 1 Agent 6).
  deletedAt      DateTime?

  @@index([organizationId, completed, dueDate])
  @@index([deletedAt])
}

model Deal {
  id             String       @id @default(cuid())
  title          String
  value          Float?
  probability    Int?         // 0-100
  stage          String       @default("PROSPECT") // PROSPECT, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  closeDate      DateTime?
  notes          String?
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation("DealAssignee", fields: [assignedToId], references: [id])
  // Phase 2 Agent 7 — canonical owner for bulk-assign. assignedToId kept for
  // back-compat; new code should write `ownerId`.
  ownerId        String?
  owner          User?        @relation("DealOwner", fields: [ownerId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  histories      DealHistory[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Soft-delete (Phase 1 Agent 6).
  deletedAt      DateTime?

  @@index([organizationId, stage])
  @@index([deletedAt])
  @@index([ownerId])
}

model DealHistory {
  id             String   @id @default(cuid())
  dealId         String
  organizationId String
  fromStage      String?
  toStage        String
  changedById    String?
  reason         String?
  createdAt      DateTime @default(now())

  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changedBy      User?        @relation(fields: [changedById], references: [id])

  @@index([dealId, createdAt])
  @@index([organizationId, createdAt])
}

// Dunning state machine — tracks failed-invoice retry cycles. One row per
// open Stripe invoice that has gone unpaid. dunningWorker (BullMQ scheduled
// job `dunning:tick`) advances rows according to a Day 0 → 3 → 7 → 10 → 30
// cadence. A row is `RESOLVED` when the matching invoice eventually pays;
// `CANCELED` when the org is canceled after the grace window.
model DunningState {
  id              String        @id @default(cuid())
  organizationId  String
  invoiceId       String        @unique // Stripe invoice id
  subscriptionId  String?       // Stripe subscription id
  attempt         Int           @default(0)
  status          DunningStatus @default(ACTIVE)
  firstFailedAt   DateTime      @default(now())
  nextActionAt    DateTime      // when the scheduler should act next
  lastEmailSentAt DateTime?
  resolvedAt      DateTime?
  amountDueCents  Int?
  currency        String?       // 3-letter ISO
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([nextActionAt, status])
}

// Stripe webhook idempotency record. Every webhook event id is upserted on
// receipt; `processedAt` is set after successful handling. A retry of the
// same event id where `processedAt` is already non-null short-circuits to
// 200 OK without re-running side-effects.
model StripeWebhookEvent {
  id          String    @id // Stripe event id (evt_*)
  type        String
  livemode    Boolean   @default(false)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt])
  @@index([type])
}

// TCPA call-window config (Phase 2 Agent 9). One row per US state +
// "DEFAULT". Federal TCPA is 8:00–21:00 LOCAL TIME for the called party;
// some states tighten it (FL/LA/MA/MS use 8:00–20:00). Seeded at boot via
// `ensureCallWindowDefaults()`. Times stored as "HH:MM" 24h strings.
model CallWindowConfig {
  id          String   @id @default(cuid())
  state       String   @unique
  allowedFrom String
  allowedTo   String
  timezone    String
  source      String   // TCPA_DEFAULT | STATE_OVERRIDE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// DNC list (Phase 2 Agent 9). organizationId NULL = platform-wide DNC,
// populated = tenant-private. phoneHash is sha256 of normalised E.164 with
// the platform-wide DNC_HASH_PEPPER mixed in — see backend/src/lib/phone.ts.
model DNCEntry {
  id             String   @id @default(cuid())
  phoneHash      String
  organizationId String?
  source         String   // TCPA_FEDERAL | STATE_DNC | TENANT_UPLOAD | VAPI_OPT_OUT | MANUAL
  reason         String?
  createdAt      DateTime @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([phoneHash, organizationId])
  @@index([organizationId, createdAt])
}

// Email suppression (Phase 2 Agent 9). organizationId NULL = platform-wide
// (used for COMPLAINED/spam reports). reason vocabulary: BOUNCED, COMPLAINED,
// UNSUBSCRIBED, MANUAL. Pre-send check in lib/email.ts short-circuits with
// status=SUPPRESSED rather than calling Resend.
model EmailSuppression {
  id             String   @id @default(cuid())
  email          String
  organizationId String?
  reason         String
  source         String?
  createdAt      DateTime @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([email, organizationId])
  @@index([organizationId, createdAt])
}

// Resend webhook idempotency. Mirrors StripeWebhookEvent.
model ResendWebhookEvent {
  id          String    @id // Resend event id
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt])
  @@index([type])
}

// ====================================================================
// Email Marketing (Phase 3 Agent 10)
// ====================================================================

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  FAILED
}

enum EmailSendStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
  FAILED
}

enum EmailRecipientSource {
  MANUAL
  CSV_IMPORT
  CAMPAIGN
  API
}

enum EmailAutomationTrigger {
  LEAD_QUALIFIED
  DEAL_WON
  CONTACT_CREATED
  CAMPAIGN_COMPLETE
}

model EmailCampaign {
  id                String              @id @default(cuid())
  organizationId    String
  name              String
  subject           String
  previewText       String?
  htmlBody          String
  textBody          String?
  status            EmailCampaignStatus @default(DRAFT)
  scheduledAt       DateTime?
  sentAt            DateTime?
  fromName          String
  fromEmail         String
  replyTo           String?
  totalRecipients   Int                 @default(0)
  totalSent         Int                 @default(0)
  totalDelivered    Int                 @default(0)
  totalOpened       Int                 @default(0)
  totalClicked      Int                 @default(0)
  totalBounced      Int                 @default(0)
  totalUnsubscribed Int                 @default(0)
  totalComplained   Int                 @default(0)
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipientLists EmailCampaignList[]
  sends          EmailSend[]
  createdBy      User?               @relation(fields: [createdById], references: [id])

  @@index([organizationId, status])
  @@index([deletedAt])
}

model EmailRecipientList {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  memberCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      EmailRecipientListMember[]
  campaigns    EmailCampaignList[]

  @@index([organizationId])
  @@index([deletedAt])
}

model EmailCampaignList {
  campaignId String
  listId     String
  campaign   EmailCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  list       EmailRecipientList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([campaignId, listId])
}

model EmailRecipientListMember {
  id             String               @id @default(cuid())
  listId         String
  contactId      String?
  email          String
  source         EmailRecipientSource
  subscribedAt   DateTime             @default(now())
  unsubscribedAt DateTime?

  list    EmailRecipientList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([listId, email])
  @@index([listId, unsubscribedAt])
  @@index([email])
}

model EmailSend {
  id                String          @id @default(cuid())
  campaignId        String
  contactId         String?
  organizationId    String
  email             String
  status            EmailSendStatus @default(QUEUED)
  providerMessageId String?         @unique
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  complainedAt      DateTime?
  unsubscribedAt    DateTime?
  failedAt          DateTime?
  errorMessage      String?
  createdAt         DateTime        @default(now())

  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([organizationId, status, createdAt])
  @@index([providerMessageId])
}

model EmailTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  subject        String
  htmlBody       String
  textBody       String?
  category       String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, category])
  @@index([deletedAt])
}

model EmailAutomation {
  id             String                 @id @default(cuid())
  organizationId String
  name           String
  trigger        EmailAutomationTrigger
  active         Boolean                @default(false)
  sequence       Json
  stats          Json                   @default("{}")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         EmailAutomationRun[]

  @@index([organizationId, active])
  @@index([deletedAt])
}

model EmailAutomationRun {
  id             String   @id @default(cuid())
  automationId   String
  organizationId String
  contactId      String?
  triggeredAt    DateTime @default(now())
  currentStep    Int      @default(0)
  status         String
  context        Json

  automation   EmailAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([automationId, status])
  @@index([organizationId, triggeredAt])
}

model Blacklist {
  id             String       @id @default(cuid())
  phoneNumber    String
  reason         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  // Soft-delete (Phase 1 Agent 6).
  deletedAt      DateTime?

  @@unique([organizationId, phoneNumber])
  @@index([organizationId, createdAt])
  @@index([deletedAt])
}

// ====================================================================
// Phase 3 Agent 12 — Per-tenant webhooks + public API.
// ====================================================================
//
// IMPORTANT: PublicApiKey is INTENTIONALLY separate from the legacy `ApiKey`
// model above. `ApiKey` stores tenant-supplied 3rd-party credentials
// (Google Maps, Gemini, Vapi). `PublicApiKey` is a Callora-issued bearer
// token that lets external developers / Zapier hit /api/v1/* on behalf of
// the org. Don't merge these — they have different security models.

enum WebhookEvent {
  LEAD_QUALIFIED
  CALL_COMPLETED
  DEAL_WON
  CAMPAIGN_COMPLETED
  EMAIL_OPENED
  EMAIL_CLICKED
}

model TenantWebhook {
  id              String         @id @default(cuid())
  organizationId  String
  url             String
  events          WebhookEvent[]
  // Tenant-stored HMAC secret. Returned ONCE at creation/rotation; not
  // hashed — we need the raw value to sign outbound deliveries. Treat as
  // sensitive (never logged, never returned in list responses).
  secret          String
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@index([organizationId, active])
  @@index([deletedAt])
}

model WebhookDelivery {
  id              String        @id @default(cuid())
  webhookId       String
  organizationId  String
  event           WebhookEvent
  payload         Json
  status          String        // PENDING | SUCCESS | FAILED | RETRYING
  responseCode    Int?
  responseBody    String?       // truncated to 1000 chars
  attempts        Int           @default(0)
  lastAttemptAt   DateTime?
  createdAt       DateTime      @default(now())

  webhook         TenantWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
  @@index([organizationId, createdAt])
  @@index([status, lastAttemptAt])
}

model PublicApiKey {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  // sha256(rawKey + DNC_HASH_PEPPER). The raw key is shown ONCE at create.
  keyHash         String   @unique
  // First 8 chars of the raw key — surfaced in the dashboard so users can
  // identify which key is which.
  prefix          String
  scopes          String[] @default(["read"])
  lastUsedAt      DateTime?
  createdById     String?
  createdAt       DateTime @default(now())
  revokedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation(fields: [createdById], references: [id])

  @@index([organizationId, revokedAt])
  @@index([prefix])
}

// ====================================================================
// Phase 5 Agent M1 — Model B PAYG: Provisioning + Credit ledger.
// ====================================================================
//
// SOFT-DELETE: None of the three models below are listed in the soft-delete
// allow-list (backend/src/lib/prismaSoftDelete.ts), and that is INTENTIONAL.
//   - TenantProvisioning + CreditLedger are 1:1 with Organization. They
//     follow the org lifecycle (cascade) and never need a "tenant trash bin".
//   - CreditTransaction is immutable accounting history — soft-deleting a
//     row would silently corrupt running balance reconstruction. Reversals
//     must be explicit REFUND / ADJUSTMENT rows, never deletes.

/// Per-tenant Vapi + Stripe provisioning state. One row per Organization,
/// created on first checkout success. Agent M2 (Stripe wrapper) populates
/// `stripeCustomerId` + `defaultPaymentMethodId`; Agent M3 (Vapi platform
/// wrapper) populates the `vapi*` fields. `failureReason` is INTERNAL —
/// never returned to tenants verbatim.
model TenantProvisioning {
  id                     String              @id @default(cuid())
  organizationId         String              @unique
  status                 ProvisioningStatus  @default(PENDING)
  vapiAssistantId        String?
  vapiPhoneNumberId      String?
  vapiPhoneE164          String?
  stripeCustomerId       String?
  defaultPaymentMethodId String?
  failureReason          String?
  steps                  Json                @default("{}")
  provisionedAt          DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// PAYG credit balance, 1:1 with Organization. Agent M2 upserts on lookup
/// (not create) — never assume a row exists for an org until checkout has
/// run. Auto-recharge thresholds are stored here so the dunning/topup
/// worker doesn't have to round-trip the Plan table.
model CreditLedger {
  id                          String   @id @default(cuid())
  organizationId              String   @unique
  balanceCents                Int      @default(0)
  lifetimeAddedCents          Int      @default(0)
  lifetimeSpentCents          Int      @default(0)
  autoRechargeEnabled         Boolean  @default(true)
  autoRechargeThresholdCents  Int      @default(1000)
  autoRechargeAmountCents     Int      @default(2500)
  lastAutoRechargeAt          DateTime?
  lowBalanceAlertSentAt       DateTime?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  organization                Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions                CreditTransaction[]
}

/// Immutable PAYG ledger entry. INSERT-ONLY — never update, never delete.
/// Reversals are NEW rows (REFUND / ADJUSTMENT). `amountCents` is signed
/// (positive credit, negative debit) and `balanceAfterCents` snapshots the
/// running balance for fast reconstruction without summing history.
/// `kind` is a String (not enum) so M5 can introduce new debit types
/// (DEBIT_CALL, DEBIT_QUALIFICATION, …) without a schema migration.
model CreditTransaction {
  id                String   @id @default(cuid())
  ledgerId          String
  organizationId    String
  kind              String   // TOPUP | TOPUP_AUTO | DEBIT_CALL | DEBIT_QUALIFICATION | DEBIT_DISCOVERY | DEBIT_EMAIL | REFUND | ADJUSTMENT
  amountCents       Int
  balanceAfterCents Int
  ref               String?  // CallLog id, Stripe paymentIntent id, etc.
  metadata          Json?
  createdAt         DateTime @default(now())

  ledger            CreditLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([ref])
}
